---
import DirectionCard from "./DirectionCard.astro";
import MysteryQuestionScene from "./MysteryQuestionScene.astro";
import ShowButtonEffects from "./ShowButtonEffects.astro";

interface Direction {
  id: string;
  number: string;
  title: string;
  eyebrow: string;
  summary: string;
  image: {
    src: string;
    width: number;
    height: number;
  };
  imageAlt: string;
  points: string[];
  accent: "violet" | "blue" | "cyan";
}

interface Props {
  directions: Direction[];
}

const { directions } = Astro.props;
---

<div class="section-heading">
  <div>
    <p class="section-index">Rozwiązania</p>
    <h2>Wybierz rozwiązanie</h2>
  </div>
  <a class="back-link" href="/">
    <span class="back-link__icon" aria-hidden="true">
      <svg viewBox="0 0 18 18">
        <path d="M15 9H4M8 5 4 9l4 4"></path>
      </svg>
    </span>
    <span class="back-link__copy">POWRÓT</span>
  </a>
</div>

<section class="direction-grid" aria-label="Trzy kierunki interactive web">
  {directions.map((direction) => <DirectionCard {...direction} />)}
  <ShowButtonEffects />
  <MysteryQuestionScene />
</section>
