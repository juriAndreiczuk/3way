---
import CourseConfigurator from "../components/demo-configurator/CourseConfigurator";
import { courseConfigurator } from "../data/courseConfigurator";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={courseConfigurator.config.description} />
    <title>{courseConfigurator.config.title}</title>
  </head>
  <body>
    <main>
      <header class="page-header">
        <h1>{courseConfigurator.config.title}</h1>
        <p>{courseConfigurator.config.description}</p>
      </header>

      <CourseConfigurator client:load />
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background: #f4f4f7;
    color: #19191f;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  main {
    width: min(100% - 2rem, 760px);
    margin: 0 auto;
    padding: 4rem 0;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  h1 {
    margin: 0 0 0.75rem;
  }

  p {
    max-width: 60ch;
    margin: 0;
    color: #5e5e6c;
    line-height: 1.6;
  }
</style>
