---
import CourseConfigurator from "../components/demo-configurator/CourseConfigurator";
import { courseConfigurator } from "../data/courseConfigurator";

const baseUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={courseConfigurator.config.description} />
    <link rel="icon" href={baseUrl + "favicon.ico"} />
    <title>{courseConfigurator.config.title}</title>
  </head>
  <body>
    <main>
      <header class="page-header">
        <h1>{courseConfigurator.config.title}</h1>
        <p>{courseConfigurator.config.description}</p>
      </header>

      <CourseConfigurator client:load />
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(circle at 50% -10%, rgba(104, 62, 191, 0.22), transparent 38rem),
      radial-gradient(circle at 90% 80%, rgba(26, 166, 206, 0.07), transparent 30rem),
      #040510;
    color: #f7f5ff;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
  }

  main {
    width: min(100% - 2rem, 1160px);
    margin: 0 auto;
    padding: 4rem 0;
  }

  .page-header {
    width: min(100%, 760px);
    margin-inline: auto;
    margin-bottom: 2rem;
    text-align: center;
  }

  h1 {
    margin: 0 0 0.75rem;
  }

  p {
    max-width: 60ch;
    margin: 0;
    margin-inline: auto;
    color: #9693aa;
    line-height: 1.6;
  }
</style>
